V2_APP_NAME="LaravelMail Validation V2"
V2_APP_ENV=production
V2_APP_KEY=
V2_APP_DEBUG=false
V2_APP_URL=http://localhost:8080
V2_LOG_CHANNEL=stack
V2_LOG_LEVEL=info
V2_CACHE_STORE=file
V2_CACHE_PREFIX=validation_v2_cache
V2_QUEUE_CONNECTION=sync
V2_SMTP_CHECK_FROM_EMAIL=noreply@emailvalidator.com
V2_DNS_TIMEOUT_SECONDS=3
V2_SMTP_TIMEOUT_SECONDS=6
V2_MAX_BATCH=10000
V2_MAX_CONCURRENT=300
V2_DISPOSABLE_DOMAINS=mailinator.com,10minutemail.com,guerrillamail.com,trashmail.com,tempmail.com,yopmail.com
V2_ROLE_PREFIXES=admin,support,info,sales,contact,webmaster,help
V2_MAIL_MAILER=log
V2_MAIL_FROM_ADDRESS=check@yourdomain.com
V2_MAIL_FROM_NAME="Validation V2"
